{
  "name": "@citari/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "tsc -p tsconfig.integration.json && node dist-integration/test/integration/postgres-http.js",
    "test:coverage": "vitest run --coverage",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx src/cli/bootstrap-superadmin.ts",
    "openapi:generate": "tsc -p tsconfig.build.json && node dist/cli/openapi-contract.js",
    "openapi:check": "tsc -p tsconfig.build.json && node dist/cli/openapi-contract.js --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "nodemailer": "9.1.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
