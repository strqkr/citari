    "db:migrate:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx src/cli/bootstrap-superadmin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "17.2.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
