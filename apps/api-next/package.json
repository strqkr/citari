{
  "name": "@citari/api-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/engines", "argon2", "esbuild", "prisma"]
  },
  "scripts": {
    "db:format": "prisma format",
