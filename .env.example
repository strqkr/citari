# Copy to .env for local development. Replace every placeholder.
POSTGRES_DB=citari
POSTGRES_USER=citari
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public
BOOTSTRAP_DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public

NODE_ENV=development
API_HOST_PORT=8000
TRUST_PROXY_HOPS=0
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=citari-web
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
NOTIFICATION_ENCRYPTION_KEY=REPLACE_WITH_A_THIRD_INDEPENDENT_32_BYTE_SECRET
APP_PUBLIC_URL=http://localhost:3000
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=notifications@example.com
CORS_ORIGINS=http://localhost:3000
