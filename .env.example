# This file is OPTIONAL. docker-compose.yml already ships development
# defaults, so "docker compose up --build" works without copying this file.
# Copy it to .env only if you want to change passwords, ports, or other settings.

SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong!Passw0rd
SQLSERVER_DB=citari

# Host port to connect DataGrip/DBeaver/SSMS to the dockerized database.
# Defaults to 11433 to avoid clashing with a local SQL Server on 1433.
SQLSERVER_HOST_PORT=11433

API_PORT=8000
FRONTEND_PORT=3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=api

# Secret used to sign/verify API JWTs (HS256). Must be 32+ chars. Generate a
# real value for each environment, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_MIN=60
CORS_ORIGINS=http://localhost:3000
LOG_FORMAT=json
