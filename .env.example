# Copy to .env for local development. Replace every placeholder.
POSTGRES_DB=citari
POSTGRES_USER=citari
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public
BOOTSTRAP_DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public

NODE_ENV=development
API_HOST_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=citari-web
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=http://localhost:3000
