# Copy this file to .env for local development. Never commit .env.
# Generate independent secrets; do not reuse passwords between environments.

POSTGRES_DB=citari
POSTGRES_USER=citari
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_HOST_PORT=5432

# Prisma connections for commands executed on the host.
DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public
BOOTSTRAP_DATABASE_URL=postgresql://citari:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/citari?schema=public

NODE_ENV=development
PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Generate at least 32 random bytes for each value.
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
